# =============================================================
# tradingview-mcp — Local Environment Configuration
# =============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values below
# 3. .env is in .gitignore — it will NEVER be committed to git
# =============================================================

# ── News (Optional — Marketaux) ───────────────────────────────
# financial_news / news-driven sentiment use the licensed Marketaux API
# (replaced the old RSS/Reddit scraping). Get a token at
# https://www.marketaux.com — without it the news tools return empty
# results (every other tool works normally).

MARKETAUX_API_TOKEN=
# Max Marketaux requests per day before serving cached/stub results
MARKETAUX_DAILY_BUDGET=90

# ── Proxy (Optional — Webshare Rotating Residential) ──────────
# Get credentials from: https://proxy.webshare.io/proxy/list
# Enables access to Yahoo Finance and Xueqiu behind rate-limits.
# Leave blank to run WITHOUT proxy (TradingView tools work fine without it).

PROXY_HOST=
PROXY_PORT=80
PROXY_USERNAME_PREFIX=
PROXY_PASSWORD=
PROXY_SESSION_MIN=1
PROXY_SESSION_MAX=250

# Set to false to disable proxy entirely
PROXY_ENABLED=false

# Public research APIs. Load explicitly: uv run --env-file .env python -m screener sources
# Never put these values in research.json, docs/, or browser JavaScript.
# SEC requires identification such as: Market Screener Your Name your@email.com
# This header is sent only to SEC. No SEC account/API key is required.
SEC_USER_AGENT=
# Alpaca paper account keys; research quotes use the free IEX feed.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Optional: FRED CSV and BLS v1 work without keys, within their limits.
FRED_API_KEY=
BLS_API_KEY=
# Free registration required for these providers.
EIA_API_KEY=
COINGECKO_DEMO_API_KEY=
